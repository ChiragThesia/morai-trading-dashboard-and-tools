# Morai -- environment contract (placeholder only, never a real credential).
# The repository is public. The live Railway Postgres password is readable at any
# time via `railway variables` -- it must never be written down here.
#
# Source of truth: src/morai/settings.py (pydantic-settings model, extra="forbid").
# A missing or malformed variable kills process boot and names the field (D-15).

DATABASE_URL=postgresql://user:password@host:5432/dbname

# The morai_app Postgres role password (phase 2). Migration 0003 creates the
# role; the web process composes its runtime DSN from this plus DATABASE_URLs
# host. Empty placeholder only -- generate with
# python3 -c "import secrets; print(secrets.token_urlsafe(32))" and set it as
# a Railway variable, never here.
MORAI_APP_DB_PASSWORD=
