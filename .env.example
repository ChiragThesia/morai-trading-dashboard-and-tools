# Morai -- environment contract (placeholder only, never a real credential).
# The repository is public. The live Railway Postgres password is readable at any
# time via `railway variables` -- it must never be written down here.
#
# Source of truth: src/morai/settings.py (pydantic-settings model, extra="forbid").
# A missing or malformed variable kills process boot and names the field (D-15).

DATABASE_URL=postgresql://user:password@host:5432/dbname
