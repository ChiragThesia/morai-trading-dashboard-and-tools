//@version=6
// MORAI · Breadth — the advance/decline line, read for a calendar seller.
//
// The A/D line is the cumulative sum of (advancing issues - declining issues). Rising means
// more stocks up than down. That is all it is. Its value is NOT directional prediction — it is
// PARTICIPATION: whether the index is being carried by the whole tape or by a handful of
// mega-caps. `knowledge-base/grouped-data/market_breadth.md` puts the payoff plainly: price at
// a new high with the A/D line failing to confirm has preceded 10-20% corrections within 4-12
// weeks.
//
// WHY A DELTA-NEUTRAL CALENDAR TRADER CARES, given the line itself is a directional tool:
// a breadth divergence is a LEAD INDICATOR ON VOL. The correction it warns about arrives as a
// VIX spike and a flattening VIX3M/VIX curve — exactly the two conditions MORAI · Vol State
// already blocks on. Breadth deteriorates WEEKS before the term structure does. So this pane
// is not a second opinion on Vol State, it is Vol State's early-warning arm. Vol State says
// "the curve is fine TODAY". This says "participation is thinning, so do not expect it to
// still be fine in a month."
//
// THE RSP/SPY ROW IS NOT DECORATION. `docs/tos-studies-learnings.md` records the user's own
// battle-tested 5-leg fragility composite, whose breadth check is "RSP/SPY ratio < its 20d
// average". `docs/architecture/regime-board.md` Refuted/Dropped #1 DROPPED that leg from the
// MORAI board: no server-fetchable source (Schwab exposes chains only, Stooq is bot-walled).
// On TradingView RSP and SPY are free. This pane restores the dropped leg.
//
// TIMEFRAME LAW (same one at the top of vol-state.pine, different function): every request
// names "D" explicitly, and every derived statistic — ta.cum, ta.highest, ta.sma, ta.ema — is
// computed INSIDE its request.security() call so it evaluates on DAILY bars. ta.cum() outside
// would accumulate over CHART bars: on a 30m chart that adds the same daily value ~13 times
// per session, and the line would be garbage that still looks plausible.
//
// LOOKAHEAD LAW: lookahead_off here, unlike vol-state.pine. Vol State may use lookahead_on
// only because it renders on barstate.islast and plots no history. An A/D line IS history, so
// lookahead_on would paint tomorrow's breadth onto today's bar and every divergence in the
// past would be a lie. The cost is honest: intraday, the last value is the PREVIOUS completed
// session. Breadth is a weeks-scale signal — a one-session lag changes nothing.
//
// SYMBOLS ARE PROBE-VERIFIED ON THIS ACCOUNT (2026-08-17), not assumed. USI:ADVN and USI:DECN
// do NOT resolve here; only the pre-differenced USI:ADD does. Same family, different answer —
// which is the documented trap in tools/tradingview/README.md.
indicator("MORAI · Breadth", overlay = false, precision = 0, format = format.volume)

// ─── Inputs ────────────────────────────────────────────────────────────────
// Every symbol is a PLAIN input. request.security() needs a SIMPLE string; wrapping one in a
// ternary demotes it to SERIES string and the study dies with a bare "cannot compile script"
// ONLY once added to a chart — the editor reports zero errors. Paid for once already.
string idxSym = input.symbol("SPCFD:SPX", "Index to test breadth against",
     tooltip = "The A/D line is only interesting relative to a price index.")
string adSym  = input.symbol("USI:ADD", "Net advances (adv - decl), daily",
     tooltip = "USI:ADD = NYSE advancing minus declining issues. USI:ADDQ for Nasdaq. " +
               "USI:ADVN / USI:DECN do NOT resolve on this account — probe before swapping.")
string vrSym  = input.symbol("USI:UVOL/USI:DVOL", "Up/down volume ratio (thrust leg)")
string ewSym  = input.symbol("AMEX:RSP/AMEX:SPY", "Equal-weight / cap-weight (fragility leg)")

int divLb  = input.int(63, "Divergence lookback (daily bars)", minval = 10,
     tooltip = "A quarter. 'New high' means highest close in this window.")
int maLb   = input.int(200, "A/D structural MA (daily bars)", minval = 20,
     tooltip = "market_breadth.md: 'A/D line breaking below 200-day MA while price holds = " +
               "hidden weakness.' 200 is the cited number.")
int ewLb   = input.int(20, "RSP/SPY average (daily bars)", minval = 5,
     tooltip = "The user's own calibrated fragility check is 20d — see tos-studies-learnings.md.")
bool tlShow = input.bool(true, "Show verdict panel")
bool showMa = input.bool(true, "Plot the A/D structural MA")

// ─── Fetch ─────────────────────────────────────────────────────────────────
// The A/D LINE is built here, inside the daily request. `close` on USI:ADD is one day's NET
// advances; ta.cum() turns the net series into the cumulative line, which is the definition.
[adl, adlHi, adlLo, adlMa] = request.security(adSym, "D",
     [ta.cum(close),
      ta.cum(close) >= ta.highest(ta.cum(close), divLb) ? 1 : 0,
      ta.cum(close) <= ta.lowest(ta.cum(close), divLb) ? 1 : 0,
      ta.sma(ta.cum(close), maLb)],
     ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)

[idx, idxHi, idxLo, idxMa] = request.security(idxSym, "D",
     [close,
      close >= ta.highest(close, divLb) ? 1 : 0,
      close <= ta.lowest(close, divLb) ? 1 : 0,
      ta.sma(close, maLb)],
     ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)

// Zweig Breadth Thrust, volume variant. Zweig's original is a 10-day EMA of
// advances/(advances+declines) crossing from below 0.40 to above 0.615 within 10 sessions.
// The issue counts are unavailable on this account, so this runs on UP/DOWN VOLUME instead —
// a common substitution, and a defensible one for an index trade because volume weights the
// participation by size rather than counting a microcap the same as a mega-cap.
//
// The feed gives the RATIO r = UVOL/DVOL, not the two legs, so the thrust fraction is
// recovered algebraically: UVOL/(UVOL+DVOL) = r/(1+r). The EMA is taken of that fraction, not
// of r — EMA(r)/(1+EMA(r)) is a different number and would move the thresholds.
//
// [ASSUMED] on the substitution: 0.40 and 0.615 are Zweig's ISSUE-based cuts, applied here to
// a volume-based series. Same disclosure class as regime-board.md's `vix9d-vix` row. Treat a
// thrust as "go look", not as a backtested trigger.
[zw, zwLo] = request.security(vrSym, "D",
     [ta.ema(close / (1.0 + close), 10),
      ta.lowest(ta.ema(close / (1.0 + close), 10), 10)],
     ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)

// The dropped fragility leg, restored. The ratio comes back as ONE spread symbol so its 20-day
// average is the average OF THE RATIO. Fetching RSP and SPY separately and dividing their SMAs
// would compute the ratio of the averages, which is a different (wrong) number.
[ew, ewAvg] = request.security(ewSym, "D", [close, ta.sma(close, ewLb)],
     ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)

// S&P-500-NATIVE breadth, as the confirming read. The NYSE A/D line above is what was asked
// for and what the literature is written about, but it counts closed-end funds, preferreds and
// ADRs — it is a bond-proxy-heavy tape, not the S&P. These two are the actual index members.
float s5fi = request.security("INDEX:S5FI", "D", close, ignore_invalid_symbol = true,
     lookahead = barmerge.lookahead_off)
float s5th = request.security("INDEX:S5TH", "D", close, ignore_invalid_symbol = true,
     lookahead = barmerge.lookahead_off)

// ─── Verdict ───────────────────────────────────────────────────────────────
// A dead feed must never read as a green light. Every verdict is gated on haveData first —
// without it, all the `== 1` tests go false on na and the panel would cheerfully print
// "CONFIRM" over an empty pane.
bool haveData = not na(adl) and not na(idx)

// The textbook divergence, in the user's own words: "if indices are rising, but the advance
// decline line is sloping downwards". Made precise: index at a new N-day high while the A/D
// line is not.
bool bearDiv = haveData and idxHi == 1 and adlHi != 1
bool bullDiv = haveData and idxLo == 1 and adlLo != 1

// The slower structural read from market_breadth.md — A/D under its own long MA while price
// still holds above its own. Catches the deterioration that never produces a clean new high.
bool hidden = haveData and not na(adlMa) and not na(idxMa) and adl < adlMa and idx > idxMa

bool thrust = not na(zw) and not na(zwLo) and zw > 0.615 and zwLo < 0.40
bool ewFrag = not na(ew) and not na(ewAvg) and ew < ewAvg

// Precedence: a thrust is a regime event and outranks a divergence, which outranks the slow
// structural read. Everything else is confirmation.
string verdict = not haveData ? "NO DATA"
     : thrust  ? "THRUST"
     : bearDiv ? "DIVERGING"
     : bullDiv ? "WASHED OUT"
     : hidden  ? "WEAK"
     : "CONFIRM"

// What each verdict means for a position that is short the front and long the back. This is
// the whole reason the pane exists, so it is on the panel, not buried in a comment.
string action = not haveData ? "—"
     : thrust  ? "OPEN — vol crush ahead"
     : bearDiv ? "NO NEW SIZE · shorten DTE"
     : bullDiv ? "WAIT — vol still rich"
     : hidden  ? "HOLD, stop adding"
     : "OK to open"

// ─── Plots ─────────────────────────────────────────────────────────────────
color AD_C = #2e86de, MA_C = #5c6879
color GO = #26a69a, WARN = #f0b429, STOP = #ef5350, MUTED = #5c6879

plot(adl, "A/D line (cumulative)", color = AD_C, linewidth = 2)
plot(showMa ? adlMa : na, "A/D " + str.tostring(maLb) + "d MA", color = MA_C, linewidth = 1)

// Marked on the TRANSITION, not the state. A shape on every bar the condition holds paints a
// solid band and stops being readable.
plotshape(bearDiv and not bearDiv[1], "Bearish divergence", shape.triangledown,
     location.abovebar, color = STOP, size = size.tiny)
plotshape(bullDiv and not bullDiv[1], "Bullish divergence", shape.triangleup,
     location.belowbar, color = GO, size = size.tiny)
plotshape(thrust and not thrust[1], "Breadth thrust", shape.circle,
     location.belowbar, color = GO, size = size.small)

bgcolor(bearDiv ? color.new(#ef5350, 90) : hidden ? color.new(#f0b429, 92) : na,
     title = "Divergence")

// ─── Verdict panel ─────────────────────────────────────────────────────────
// Every row carries a WORD as well as a colour — no verdict rests on hue alone. And every
// number the verdict was computed from is on the same panel: a verdict you cannot audit from
// where you read it is a black box.
var table tl = table.new(position.top_right, 2, 6, border_width = 0,
     frame_width = 1, frame_color = #27313f)

color vCol = not haveData ? MUTED : thrust ? GO : bearDiv ? STOP
     : bullDiv ? WARN : hidden ? WARN : GO

if barstate.islast
    if tlShow
        table.cell(tl, 0, 0, "BREADTH", text_color = #9aa3b8, text_size = size.small)
        table.cell(tl, 1, 0, verdict, text_color = vCol, text_size = size.normal)

        table.cell(tl, 0, 1, "CALENDAR", text_color = #9aa3b8, text_size = size.small)
        table.cell(tl, 1, 1, action, text_color = vCol, text_size = size.small)

        // Is the line making highs with price, or lagging?
        string adWord = not haveData ? "—" : adlHi == 1 ? "at " + str.tostring(divLb) + "d high"
             : adlLo == 1 ? "at " + str.tostring(divLb) + "d LOW"
             : na(adlMa) ? "mid-range" : adl > adlMa ? "above " + str.tostring(maLb) + "d MA"
             : "BELOW " + str.tostring(maLb) + "d MA"
        table.cell(tl, 0, 2, "A/D", text_color = #9aa3b8, text_size = size.small)
        table.cell(tl, 1, 2, adWord,
             text_color = not haveData ? MUTED : (adlHi == 1 or (not na(adlMa) and adl > adlMa))
             ? #d6dbe4 : WARN, text_size = size.small)

        // The user's own fragility check, restored from the dropped board leg.
        table.cell(tl, 0, 3, "RSP/SPY", text_color = #9aa3b8, text_size = size.small)
        table.cell(tl, 1, 3, na(ew) ? "—"
             : str.tostring(ew, "#.####") + (ewFrag ? "  FRAGILE" : "  ok"),
             text_color = na(ew) ? MUTED : ewFrag ? WARN : #d6dbe4, text_size = size.small)

        // S&P-native breadth. Named as percentages so they are never confused with the ratio.
        table.cell(tl, 0, 4, "S&P >50d", text_color = #9aa3b8, text_size = size.small)
        table.cell(tl, 1, 4, na(s5fi) ? "—" : str.tostring(s5fi, "#") + "%",
             text_color = na(s5fi) ? MUTED : s5fi < 40 ? WARN : #d6dbe4, text_size = size.small)

        table.cell(tl, 0, 5, "S&P >200d", text_color = #9aa3b8, text_size = size.small)
        table.cell(tl, 1, 5, na(s5th) ? "—" : str.tostring(s5th, "#") + "%",
             text_color = na(s5th) ? MUTED : s5th < 50 ? WARN : #d6dbe4, text_size = size.small)
    else
        table.clear(tl, 0, 0, 1, 5)

// ─── Alerts ────────────────────────────────────────────────────────────────
// Transitions, not states — a level-triggered alert on `bearDiv` fires every bar for as long
// as the divergence holds, which on a 30m chart is 13 alerts a day saying the same thing.
alertcondition(bearDiv and not bearDiv[1], "Breadth · BEARISH divergence",
     "Index at a new high, A/D line is not. Vol spike risk builds over 4-12 weeks — no new " +
     "calendar size, shorten DTE on what is open.")
alertcondition(thrust and not thrust[1], "Breadth · THRUST",
     "Breadth thrust fired. Participation broadening — the window where calendars open best.")
alertcondition(hidden and not hidden[1], "Breadth · hidden weakness",
     "A/D line below its long MA while price holds above its own. Stop adding.")
